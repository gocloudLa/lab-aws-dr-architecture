# Copiar a terraform.tfvars y completar con datos propios. terraform.tfvars está ignorado.

public_zone_id     = "Z0123456789ABCDEFGHIJ"
public_domain_name = "demo.example.com"

certificate_arn_primary   = "arn:aws:acm:us-east-2:123456789012:certificate/00000000-0000-0000-0000-000000000000"
certificate_arn_secondary = "arn:aws:acm:us-east-1:123456789012:certificate/11111111-1111-1111-1111-111111111111"

# Red existente en cada región. Los patrones se resuelven por tag Name y admiten comodín.
# app_cidr_blocks alimenta el ingress PostgreSQL de Aurora en la región opuesta, así que
# debe listar los CIDR reales de las subredes donde corren las tareas ECS.
primary_network = {
  vpc_name                    = "gcl-lab"
  app_subnet_name             = "gcl-lab-private*"
  public_subnet_name          = "gcl-lab-public*"
  database_subnet_name        = "gcl-lab-database*"
  default_security_group_name = "gcl-lab-default"
  app_cidr_blocks             = ["10.20.64.0/20", "10.20.80.0/20"]
}

secondary_network = {
  vpc_name                    = "gcl-lab"
  app_subnet_name             = "gcl-lab-private*"
  public_subnet_name          = "gcl-lab-public*"
  database_subnet_name        = "gcl-lab-database*"
  default_security_group_name = "gcl-lab-default"
  app_cidr_blocks             = ["10.30.64.0/20", "10.30.80.0/20"]
}

# Bootstrap: aplicar con 0, publicar la imagen en ambos ECR y recién entonces subir a 1.
container_image_tag = "bootstrap-required"
ecs_desired_count   = 0

arc_aurora_behavior = "switchoverOnly"
deletion_protection = true
